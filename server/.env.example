# 복사해서 .env 로 쓰기 (.env 는 커밋하지 않음)
DATABASE_URL=postgresql+psycopg://spasiba:spasiba@db:5432/spasiba
MQTT_ENABLED=true
MQTT_HOST=broker
MQTT_PORT=1883
MQTT_USERNAME=cloud-server
