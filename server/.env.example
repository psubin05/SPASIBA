# 복사해서 .env 로 쓰기 (.env 는 커밋하지 않음)
DATABASE_URL=postgresql+psycopg://spasiba:spasiba@db:5432/spasiba
MQTT_ENABLED=true
MQTT_HOST=broker
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CA=
ADMIN_TOKEN=
TIMEZONE=Asia/Seoul
MATCH_MIN_VOTES=5
MATCH_PENDING_SECONDS=120
CROP_ENABLED=false
CROP_DIR=/srv/crops
