# Deployment template only: replace placeholders and provision TLS/ACL first.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/spasiba?sslmode=require
MQTT_ENABLED=true
MQTT_HOST=YOUR_BROKER_HOST
MQTT_PORT=8883
MQTT_USERNAME=cloud-server
MQTT_PASSWORD=REPLACE_WITH_SERVER_ACCOUNT_PASSWORD
MQTT_TLS=true
# Leave empty for a publicly trusted certificate; otherwise provide the CA file.
MQTT_CA_CERT=
ADMIN_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN
TIMEZONE=Asia/Seoul
MATCH_MIN_VOTES=5
MATCH_PENDING_SECONDS=120
CROP_DIR=crops
SIMULATOR_ENABLED=false
SEED_SAMPLE_MAP=false
